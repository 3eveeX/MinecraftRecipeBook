@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Recipe Book!</h1>

<h3>Welcome to the minecraft recipe book!</h3>

<h3>Current Recipies</h3>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ingredients</th>
            <th>Count</th>
            <th>Result</th>
            <th>Shapeless</th>
        </tr>
    </thead>
    <tbody>
        @foreach(Recipe recipe in recipes)
		{
			<tr>
				<td>@recipe.Id</td>
				<td>
					<table class="table">
						@for(int j = 0; j < 3; j++)
						{

							<tr>
								@for(int k = 0; k < 3; k++)
								{
									int ingredientId = recipe.Ingredients[j * 3 + k];
									if(ingredientId == -1)
									{
										<td>----------</td>
									}
									else
									{
										<td>
										<img src=@items[ingredientId].ImagePath alt=@items[ingredientId].Name width="50" />
										</td>
										
									}
								}
							</tr>
						}
					</table>
					
				</td>
				<td>@recipe.Count</td>
				<td>
					<img src=@items[recipe.Result].ImagePath alt=@items[recipe.Result].Name width="50" />
				</td>
				<td>@(recipe.Shapeless ? "Yes" : "No")</td>
				<td><button class="btn btn-danger" @onclick="() => deleteRecipe(recipe.Id)">Delete</button></td>
			</tr>
		}
    </tbody>
</table>

<h3>New Recipe</h3>

<EditForm FormName="New Recipe" OnValidSubmit="OnSubmitNewRecipe" Model="currentRecipe">
	<div>
		<input type="hidden" value="@currentRecipe.Id" />
	</div>

	<div>
		<label for="ingredients">Ingredients:</label>
		<table class="table">
			@for (int j = 0; j < 3; j++)
			{
				<br/>
				<tr>
					@for (int k = 0; k < 3; k++)
					{
						int ingredientId = (j * 3 + k);
						<InputSelect id="result" @bind-Value=currentRecipe.Ingredients[ingredientId]>
							<option value="-1">Nothing</option>
							@foreach (Item item in items)
							{
								<option value="@item.Id">@item.Name</option>
							}
						</InputSelect>
					}
				</tr>
			}
		</table>
	</div>

	<div>
		<label for="count">Count:</label>
		<InputNumber id="count" @bind-Value="currentRecipe.Count" />
	</div>

	<div>
		<label for="result">Output:</label>
		<InputSelect id="result" @bind-Value=currentRecipe.Result>
			@foreach (Item item in items)
			{
				<option value="@item.Id">@item.Name</option>
			}
		</InputSelect>
	</div>

	<div>
		<label for="shapeless">Shapeless:</label>
		<InputCheckbox id="shapeless" @bind-Value="currentRecipe.Shapeless" />
	</div>

	<button type="submit" style:"btn btn-primary">Submit</button>
</EditForm>

@code {

	private static List<Item> items = new List<Item>()
	{
		new Item() { Name = "Oak Planks", ImagePath = "images/Oak_Planks.png"},
		new Item() { Name = "Stick", ImagePath = "images/Stick.png"},
		new Item() { Name = "Crafting Table", ImagePath = "images/Crafting_Table.png"},
		new Item() { Name = "Wooden Pickaxe", ImagePath = "images/Wooden_Pickaxe.png"},
		new Item() { Name = "Wooden Shovel", ImagePath = "images/Wooden_Shovel.png"}
	};


	private static Recipe? currentRecipe = null;

	protected override void OnInitialized()
	{
		base.OnInitialized();
		if (currentRecipe == null)
		{
			currentRecipe = new Recipe();
		}
		
	}

	private void deleteRecipe(int id)
	{
		recipes.RemoveAll(r => r.Id == id);
	}

	private static List<Recipe> recipes = new List<Recipe>()
	{
		new Recipe() { Ingredients = new int[] {-1,0,-1,-1,0,-1,-1,-1,-1}, Count = 4, Result = 1, Shapeless = false}, //sticks
		new Recipe() { Ingredients = new int[] {0,0,-1,0,0,-1,-1,-1,-1}, Count = 1, Result = 2, Shapeless = false}, //crafting table
		new Recipe() { Ingredients = new int[] {0,0,0,-1,1,-1,-1,1,-1 }, Count = 1, Result = 3, Shapeless = false}, //wooden pickaxe
		new Recipe() { Ingredients = new int[] {-1,0,-1,-1,1,-1,-1,1,-1 }, Count = 1, Result = 4, Shapeless = false} //wooden shovel
	};

	private void OnSubmitNewRecipe()
	{
		recipes.Add(currentRecipe);
		currentRecipe = new Recipe();
	}
	
}
